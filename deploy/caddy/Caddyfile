# The blue/green front door (deploy/truenas-bluegreen.yml). Static: it never changes during a swap.
# Which colour is live is the one snippet in /etc/caddy-active/active.caddy, which is the host's file
# ($BOSSMAN_DEPLOYER/proxy/active.caddy, mounted read-only). The host deployer rewrites it, runs
# `caddy validate`, then `caddy reload` through `docker compose exec`; nothing else changes it.
{
	# The admin API listens inside this container only (not published); `docker compose exec proxy caddy reload` talks to it.
	admin localhost:2019
	auto_https off

	# Who may tell Caddy the real client address with X-Forwarded-For / -Proto. Only the UI listener ever does, and only
	# for the addresses in BOSSMAN_CADDY_TRUSTED_PROXIES (the Tailscale container, set by deploy/tailscale-bluegreen.yml).
	# Unset = nobody: the default is an address nothing can have. "Strict" reads the header from the right, so a client
	# cannot put a made-up address in front of the real one. The portal on :3101 never trusts forwarded headers.
	servers :3100 {
		trusted_proxies static {$BOSSMAN_CADDY_TRUSTED_PROXIES:127.255.255.254/32}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

# Defines the snippet (active) = reverse_proxy to the live colour. {args[0]} is the colour's port, {args[1]} the path
# Caddy polls to see it is up (active health check, every 2 s).
import /etc/caddy-active/active.caddy

# The owner's UI, the API and the runner websocket (runners dial ws://server:3100/api/runner/connect).
:3100 {
	import active 3100 /api/ready
}

# The feedback portal (BOSSMAN_PORTAL_PORT inside the colours).
:3101 {
	import active 3101 /portal.html
}
