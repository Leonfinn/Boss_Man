{
  "name": "boss-man",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm --filter @boss-man/web build",
    "build:site": "pnpm --filter @boss-man/site build",
    "dev": "pnpm --filter @boss-man/server dev",
    "dev:web": "pnpm --filter @boss-man/web dev",
    "db:generate": "pnpm --filter @boss-man/server db:generate"
  },
  "pnpm": {
    "overrides": {
      "hono@<4.13.16": "4.13.16",
      "@hono/node-server@<2.1.6": "2.1.6",
      "body-parser@<2.4.0": "2.4.0",
      "fast-uri@<3.1.9": "3.1.9",
      "fast-uri@>=4.0.0 <4.2.3": "4.2.3",
      "glob@<14.0.2": "14.0.2",
      "minimatch@<11.0.1": "11.0.1",
      "esbuild@<0.25.0": "0.25.12"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
